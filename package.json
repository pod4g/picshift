{
  "name": "picshift",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "seo:audit": "node scripts/seo-audit.mjs",
    "geo:audit": "node scripts/geo-audit.mjs",
    "pwa:audit": "node scripts/pwa-audit.mjs",
    "gsc:export": "node scripts/gsc-export.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "indexnow": "node scripts/indexnow-submit.mjs",
    "e2e": "playwright test",
    "e2e:prod": "PLAYWRIGHT_SERVER_MODE=preview PLAYWRIGHT_PORT=4322 playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "verify": "pnpm build && pnpm seo:audit && pnpm geo:audit && pnpm pwa:audit && pnpm test:unit && pnpm typecheck && pnpm e2e:prod"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.0",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^5.17.1",
    "canvas-confetti": "^1.9.4",
    "exifr": "^7.1.3",
    "fflate": "^0.8.2",
    "libheif-js": "1.19.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/webp": "^1.5.0",
    "@panda-ai/imagequant": "^0.2.0",
    "@playwright/test": "^1.58.2",
    "@types/canvas-confetti": "^1.9.0",
    "@vite-pwa/astro": "^1.2.0",
    "typescript": "5.9.3"
  }
}
