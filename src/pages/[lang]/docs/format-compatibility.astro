  commonConversionPaths: 'Common conversion paths',
  conversionPaths: [
    'HEIC to JPG: easier sharing across legacy apps and websites.',
    'PNG to JPG: reduce file size for photographic content.',
    'JPG to WebP: compare output quality and size; a reduction is common but not guaranteed for every source.',
    'WebP to JPG: broader compatibility with older apps, upload forms, and print workflows.',
  ],
