  },
  it: {
    intro:
      'Questa pagina raccoglie informazioni pratiche di compatibilità sui formati immagine comuni in PicShift. Usala come riferimento rapido per scegliere il formato di output per web, condivisione o archivio.',
    supportedFormats: 'Formati supportati',
    tableHeaders: ['Formato', 'Uso tipico', 'Trasparenza', 'Tipo di compressione'],
    rows: [
      ['JPG / JPEG', 'Foto, condivisione social', 'No', 'Lossy'],
      ['PNG', 'Asset UI, loghi, screenshot', 'Sì', 'Lossless'],
